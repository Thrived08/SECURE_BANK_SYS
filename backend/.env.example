# Copy this file to .env and fill in real values. NEVER commit .env to git.

PORT=4000

# Generate a strong random secret, e.g. run: openssl rand -hex 64
JWT_SECRET=replace_this_with_a_long_random_string

# Access tokens are short-lived on purpose (security best practice)
JWT_EXPIRES_IN=15m

# SQLite file location (fine for learning; swap for Postgres in production)
DB_PATH=./data/bank.db

# bcrypt cost factor - higher = slower to brute force but slower to compute
BCRYPT_ROUNDS=12
